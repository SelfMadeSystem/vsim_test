{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "hdl",
      "camelcase": "Hdl",
      "title": "Hdl",
      "scope": "source.hdl",
      "file-types": [
        "hdl"
      ],
      "injection-regex": "^hdl$",
      "class-name": "TreeSitterHdl"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Hardware Description Language",
    "authors": [
      {
        "name": "SelfMadeSystem",
        "email": "sms@shoghisimon.ca",
        "url": "https://shoghisimon.ca"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-hdl",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}